# PostgreSQL (Neon) connection string — required
DATABASE_URL=

# Secret used to sign admin session JWTs (any long random string) — required in production
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Image storage — Neon Object Storage (S3-compatible) — required in production.
# Server-side only: never expose these to the browser.
#
# Create a bucket with public_read access and a storage credential on the
# PRODUCTION branch:
#   npx neon buckets create assets --access-level public_read
#   npx neon credentials create --scope storage:read --scope storage:write
# or use `neon env pull` / the Neon Console (Object storage tab).
#
# Required in Vercel for Production, Preview AND Development environments:
#   AWS_ENDPOINT_URL_S3     branch storage endpoint, e.g. https://br-xxx.storage.c-6.us-east-2.aws.neon.tech
#   AWS_ACCESS_KEY_ID       Neon credential token_id (nak_live_...)
#   AWS_SECRET_ACCESS_KEY   Neon credential secret (nsk_live_...) — shown once
#   AWS_REGION              e.g. us-east-2
#   AWS_S3_BUCKET           bucket name, e.g. assets
#   (legacy alias: NEON_STORAGE_BUCKET — AWS_S3_BUCKET takes precedence)
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=assets

# Image storage — Cloudinary (alternative provider, server-side only).
# Used only when the Neon variables above are not set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local-disk fallback (public/uploads) is used when neither provider is
# configured — development convenience only; NOT suitable for Vercel.
