# PostgreSQL (Neon) connection string — required
DATABASE_URL=

# Secret used to sign admin session JWTs (any long random string) — required in production
AUTH_SECRET=

# Image storage — Cloudinary (recommended for production; server-side only).
# Leave blank to fall back to local-disk storage under public/uploads (development).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved for alternative storage providers (unused when Cloudinary is set)
IMAGE_STORAGE_URL=
IMAGE_STORAGE_KEY=
IMAGE_STORAGE_SECRET=
